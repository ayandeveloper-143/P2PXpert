<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#181a20"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp">

        <!-- App Logo -->
        <ImageView
            android:layout_width="wrap_content"
            android:layout_height="58dp"
            android:layout_gravity="center_horizontal"
            android:layout_marginBottom="32dp"
            android:contentDescription="P2PXpress Logo"
            android:src="@drawable/logo" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- Pehla Layout - Back aur Title -->
            <RelativeLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="4dp">

                <ImageButton
                    android:id="@+id/back_btn_forget"
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:layout_alignParentStart="true"
                    android:layout_centerVertical="true"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:src="@drawable/ic_arrow_back"
                    android:tint="#eaecef" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_centerInParent="true"
                    android:gravity="center"
                    android:text="Reset Password"
                    android:textColor="#eaecef"
                    android:textSize="24sp"
                    android:textStyle="bold" />

            </RelativeLayout>

            <!-- Dusra Layout - Logo aur Description -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="32dp"
                android:gravity="center_horizontal"
                android:orientation="vertical">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:lineSpacingExtra="4dp"
                    android:text="Enter your registered email or phone to get reset link"
                    android:textColor="#848e9c"
                    android:textSize="14sp" />

            </LinearLayout>

        </LinearLayout>

        <!-- Email/Phone Input -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="20dp"
            android:orientation="vertical">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="8dp"
                android:text="Email or Phone"
                android:textColor="#b7bdc6"
                android:textSize="14sp" />

            <RelativeLayout
                android:id="@+id/reset_identifier_layout"
                android:layout_width="match_parent"
                android:layout_height="50dp"
                android:background="@drawable/edit_text_transition">

                <ImageView
                    android:id="@+id/user_icon"
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:layout_centerVertical="true"
                    android:layout_marginStart="14dp"
                    android:src="@drawable/ic_person"
                    android:tint="#848e9c" />

                <EditText
                    android:id="@+id/reset_identifier"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_centerVertical="true"
                    android:layout_toEndOf="@id/user_icon"
                    android:background="@android:color/transparent"
                    android:hint="Enter your email or phone"
                    android:inputType="text"
                    android:padding="14dp"
                    android:textColor="#eaecef"
                    android:textColorHint="#848e9c"
                    android:textSize="16sp" />
            </RelativeLayout>

            <TextView
                android:id="@+id/reset_identifier_error"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Please enter a valid email or phone"
                android:textColor="#f6465d"
                android:textSize="12sp"
                android:visibility="gone" />
        </LinearLayout>

        <!-- Send Reset Link Button -->

        <Button
            android:id="@+id/reset_request_btn"
            android:layout_width="match_parent"
            android:layout_height="55dp"
            android:background="@drawable/btn_yellow_rounded"
            android:minWidth="0dp"
            android:minHeight="0dp"
            android:text="Send Reset Link"
            android:textColor="#181a20"
            android:textSize="16sp"
            android:textStyle="bold" />

    </LinearLayout>
</ScrollView>