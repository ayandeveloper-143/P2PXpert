<?xml version="1.0" encoding="utf-8"?>
<animated-selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:id="@+id/on">
        <shape android:shape="oval">
            <solid android:color="#f6465d" />
            <size android:width="8dp" android:height="8dp" />
        </shape>
    </item>
    <item android:id="@+id/off">
        <shape android:shape="oval">
            <solid android:color="#30f6465d" />
            <size android:width="8dp" android:height="8dp" />
        </shape>
    </item>
    <transition
        android:fromId="@+id/off"
        android:toId="@+id/on">
        <animation-list>
            <item android:duration="100" android:drawable="@drawable/live_badge_on" />
            <item android:duration="100" android:drawable="@drawable/live_badge_off" />
        </animation-list>
    </transition>
</animated-selector>